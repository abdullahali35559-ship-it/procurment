# ============================================
# PROCUREMENT PORTAL - VPS ENVIRONMENT TEMPLATE
# ============================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://procurement_user:YOUR_SECURE_PASSWORD@localhost:5432/procurement_db

# LLM Configuration
LLM_PROVIDER=openrouter  # 'pixtral' or 'openrouter'
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Storage Configuration (Absolute path on VPS recommended)
STORAGE_PATH=./storage/procurement

# Email Integration (Outlook OAuth Recommended)
OUTLOOK_OAUTH_ENABLED=true
OUTLOOK_CLIENT_ID=your_azure_client_id
OUTLOOK_CLIENT_SECRET=your_azure_client_secret
OUTLOOK_TENANT_ID=consumers
OUTLOOK_REDIRECT_URI=https://procurement.socialaihub.online/api/oauth/callback

# Gmail Integration (If used)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password

# Regional Settings
TIMEZONE=Asia/Karachi
COMPANY_NAME=Procurement Executive

# Security
SECRET_KEY=generate_a_random_string_here
